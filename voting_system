pragma solidity ^0.8.3;
contract voting{
    mapping(uint256 => uint256) public votes;
    uint256[] public candidateId;
    function addCandidate(uint256 _candidateId) external {
        candidateId.push(_candidateId);
    }
    function castVote(uint256 _candidateId) external{
        votes[_candidateId] += 1;
    }
    function getvotesCount(uint256 _candidateId) external view returns(uint256){
        return votes[_candidateId]
    }
}
